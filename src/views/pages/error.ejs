<div class="glass-card fade-up" style="max-width: 640px; margin: 0 auto; text-align: center;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
    <h2 class="gradient-text"><%= message %></h2>
    <p style="margin: 1rem 0; font-size: 1rem;">
        Status: <strong style="color:var(--text);"><%= error.status %></strong>
    </p>
    <pre style="text-align:left; background: rgba(3,5,13,.7); padding: 1rem; border-radius: 12px; overflow:auto; font-size:.78rem; color: var(--text-muted); border:1px solid var(--border); max-height: 260px;"><%= error.stack %></pre>
    <a href="/" class="btn" style="margin-top: 1.5rem;">← Voltar ao início</a>
</div>