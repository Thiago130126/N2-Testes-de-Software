<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="EduStream — plataforma de e-learning para você se desenvolver e aprender.">
        <title><%= typeof title !== 'undefined' ? title + ' • EduStream' : 'EduStream' %></title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/style.css">
        <% if (typeof pageStyles !== 'undefined' && pageStyles) { %>
            <% pageStyles.forEach(function(href){ %>
                <link rel="stylesheet" href="<%= href %>">
            <% }) %>
        <% } %>
    </head>
    <body>
        <div class="bg-orbs" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>
        <%- include('../partials/header') %>
        <main>
            <%- body %>
        </main>
        <%- include('../partials/footer') %>
    </body>
</html>
